# Local Earth Engine authentication uses credentials created by:
# earthengine authenticate
EARTHENGINE_PROJECT=your-google-cloud-project-id

# Production service account (optional):
# GEE_SERVICE_ACCOUNT=service-account@your-project.iam.gserviceaccount.com
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# Safety/quality settings (optional):
GEE_MAX_REQUEST_DAYS=5000
GEE_MIN_VALID_FRACTION=0.10
