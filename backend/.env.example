DATABASE_URL=postgresql+asyncpg://vegmon:vegmon@localhost:5432/vegmon
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["*"]
SQL_ECHO=false

# Отправка писем подтверждения почты (Brevo SMTP relay). Если не задано —
# письмо не шлётся, токен по-прежнему возвращается в ответе /auth/register.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=
MAIL_FROM=SkyTime <noreply@daniel.crazedns.ru>
FRONTEND_BASE_URL=https://skytime.daniel.crazedns.ru

# Google Earth Engine — живой сбор Sentinel-2/Landsat/MODIS/ERA5
# (GET /polygons/{id}/live-sources). Требует `earthengine authenticate`
# от пользователя, из-под которого запущен процесс (credentials — секрет,
# не хранится в репозитории), затем project id сюда.
EARTHENGINE_PROJECT=
